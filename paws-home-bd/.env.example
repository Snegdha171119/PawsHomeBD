# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=PawsHomeBD

# Gmail (use a Gmail App Password, not your normal password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password

# Pusher (from your pusher.com app keys page)
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=ap2

# JWT secrets, one per role (any long random text)
ADMIN_JWT_SECRET=change_me_admin
VET_JWT_SECRET=change_me_vet
LISTER_JWT_SECRET=change_me_lister
ADOPTER_JWT_SECRET=change_me_adopter
